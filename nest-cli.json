{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/techcare/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/techcare/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/techcare",
  "projects": {
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "file-manager": {
      "type": "application",
      "root": "apps/file-manager",
      "entryFile": "main",
      "sourceRoot": "apps/file-manager/src",
      "compilerOptions": {
        "tsConfigPath": "apps/file-manager/tsconfig.app.json"
      }
    },
    "inventory-manager": {
      "type": "application",
      "root": "apps/inventory-manager",
      "entryFile": "main",
      "sourceRoot": "apps/inventory-manager/src",
      "compilerOptions": {
        "tsConfigPath": "apps/inventory-manager/tsconfig.app.json"
      }
    },
    "notification-manager": {
      "type": "application",
      "root": "apps/notification-manager",
      "entryFile": "main",
      "sourceRoot": "apps/notification-manager/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-manager/tsconfig.app.json"
      }
    },
    "product-manager": {
      "type": "application",
      "root": "apps/product-manager",
      "entryFile": "main",
      "sourceRoot": "apps/product-manager/src",
      "compilerOptions": {
        "tsConfigPath": "apps/product-manager/tsconfig.app.json"
      }
    },
    "techcare": {
      "type": "application",
      "root": "apps/techcare",
      "entryFile": "main",
      "sourceRoot": "apps/techcare/src",
      "compilerOptions": {
        "tsConfigPath": "apps/techcare/tsconfig.app.json"
      }
    },
    "utilisateur": {
      "type": "application",
      "root": "apps/utilisateur",
      "entryFile": "main",
      "sourceRoot": "apps/utilisateur/src",
      "compilerOptions": {
        "tsConfigPath": "apps/utilisateur/tsconfig.app.json"
      }
    }
  }
}